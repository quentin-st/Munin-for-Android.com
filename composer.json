{
    "name": "quentin-st/munin-for-android.com",
    "description": "www.munin-for-android.com",
    "keywords": [],
    "homepage": "https://www.munin-for-android.com",
    "license": "MIT",
    "minimum-stability": "stable",
    "prefer-stable": true,
    "require": {
        "php": ">=8.4.0",
        "slim/psr7": "^1.8",
        "slim/slim": "^4.15",
        "slim/twig-view": "^3.4"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.3",
        "roave/security-advisories": "dev-latest"
    },
    "config": {
        "process-timeout": 0,
        "sort-packages": true
    },
    "autoload": {
        "classmap": ["src/helpers/"]
    },
    "scripts": {
        "start": "php -S 0.0.0.0:8080 -t public public/index.php"
    }
}
